# Mamalik database package environment example.
# Copy this file to .env for local Prisma CLI usage. Do not commit real secrets.

DATABASE_URL=postgresql://mamalik:mamalik@localhost:5432/mamalik?schema=public

# Optional local-dev fallback for app validation when land-mask seed data is missing.
# Leave false/empty in production.
ALLOW_MISSING_LAND_MASK=false
