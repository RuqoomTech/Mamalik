# Mamalik web app environment example.
# Copy this file to .env.local for local development. Do not commit real secrets.

# Public app origin used by auth callbacks, links, and local smoke tests.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL/PostGIS connection string for Prisma and database tasks.
DATABASE_URL=postgresql://mamalik:mamalik@localhost:5432/mamalik?schema=public

# Server-side session secret. Replace with a long random value in real environments.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Google OAuth credentials. Configure during the Google login task.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Public MapLibre style URL. This can be replaced when a production map style is chosen.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Optional local-dev fallback. Leave false/empty in production so missing map data blocks kingdom creation.
ALLOW_MISSING_LAND_MASK=false

# Comma-separated admin email allowlist for v0.1 admin access.
ADMIN_EMAILS=admin@example.com

# Shared secret for protected tick-worker/admin-triggered tick calls.
TICK_WORKER_SECRET=replace-with-a-long-random-worker-secret
